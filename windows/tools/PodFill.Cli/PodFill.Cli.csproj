    <OutputType>Exe</OutputType>
    <AssemblyName>podfill-cli</AssemblyName>
    <RootNamespace>PodFill.Cli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/PodFill.Core/PodFill.Core.csproj" />
  </ItemGroup>
</Project>
